{
  "name": "@rohanyeole/ray-editor-react",
  "version": "2.0.0",
  "description": "React wrapper for RayEditor — free, dependency-free WYSIWYG rich text editor",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c"
  },
  "keywords": ["ray-editor", "react", "react-editor", "wysiwyg", "rich-text-editor"],
  "author": "Rohan Yeole",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yeole-rohan/ray-editor",
    "directory": "packages/react"
  },
  "homepage": "https://ray-editor.rohanyeole.com",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0",
    "@rohanyeole/ray-editor": "^2.0.0"
  },
  "devDependencies": {
    "@rohanyeole/ray-editor": "^2.0.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
